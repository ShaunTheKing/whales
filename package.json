{
  "name": "whales",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first multi-agent workspace on Cordis",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "whales": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "web/dist",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=20000 \"test/**/*.test.ts\"",
    "check": "pnpm typecheck && pnpm test",
    "spike": "node scripts/spike.ts",
    "build": "tsc -p tsconfig.build.json && pnpm --filter whales-web build",
    "prepack": "pnpm build",
    "desktop": "pnpm build && electron .",
    "desktop:dist": "pnpm build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "cordis": "4.0.0-rc.10",
    "hono": "4.13.9",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.1",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "typescript": "5.9.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.23.0",
  "main": "dist/desktop/main.js"
}
