{
  "name": "whales",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first multi-agent workspace on Cordis",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "whales": "./src/cli/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=20000 \"test/**/*.test.ts\"",
    "check": "pnpm typecheck && pnpm test",
    "spike": "node scripts/spike.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "cordis": "4.0.0-rc.10",
    "hono": "4.13.9",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.23.0"
}
