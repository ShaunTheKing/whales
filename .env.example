# Copy to .env (git-ignored) or export in your shell. Whales never stores these values;
# agent specs and config only reference the variable NAME (e.g. "apiKeyEnv": "DEEPSEEK_API_KEY").

# Where Whales keeps its SQLite DB, skills, workspaces and checkpoints. Default: ~/.whales
WHALES_DATA_DIR=

# Bearer token for the HTTP/WebSocket API (required if the server binds to anything but 127.0.0.1)
WHALES_API_TOKEN=

# driver-openai-compat presets
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Ollama needs no key (http://127.0.0.1:11434/v1)

# driver-acp / Claude Code (used by the claude-code ACP adapter process)
ANTHROPIC_API_KEY=

# bridge-telegram (Phase 5)
TELEGRAM_BOT_TOKEN=
